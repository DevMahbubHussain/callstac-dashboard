# Docker Environment Variables for CallStac Dashboard
# Copy this file to .docker.env and adjust as needed

# Application
APP_NAME=CallStac
APP_ENV=production
APP_KEY=base64:your-generated-app-key-here
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=callstac
DB_USERNAME=callstac_user
DB_PASSWORD=callstac_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Queue
QUEUE_CONNECTION=redis

# Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis